# Python
__pycache__/
*.py[cod]
*.so

# Model files
/models/*

# Ignore everything in the models directory
models/*

# But don't ignore the .gitkeep files in models and its subdirectories
!models/.gitkeep
!models/*/.gitkeep

# Don't ignore specific configuration files
!models/llama_tokenizer/tokenizer_config.json
!models/llama_tokenizer/special_tokens_map.json

# Ignore all other files in subdirectories
models/*/*
!models/llama_tokenizer/*

# Virtual environment
.venv/
venv/

# VS Code
.vscode/

# FFmpeg folder (as suggested earlier)
/ffmpeg/*
!/ffmpeg/.gitkeep

# PyInstaller
build/
dist/

# Inno Setup
Output/

# User-specific files
*.log
whisper_gui_settings.json